{
  "name": "blikka",
  "type": "module",
  "private": true,
  "scripts": {
    "up": "bun scripts/up.ts",
    "dev": "env -u npm_execpath alchemy dev",
    "deploy": "drizzle-kit check && drizzle-kit migrate && alchemy deploy",
    "deploy:prod": "drizzle-kit check && bun --env-file=.env.prod run drizzle-kit migrate && alchemy deploy --stage prod --env-file .env.prod",
    "destroy": "alchemy destroy",
    "db:generate": "drizzle-kit generate --name",
    "api:generate": "bun scripts/openapi.ts > openapi.json && openapi-typescript openapi.json -o src/web/api.gen.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@effect/platform-node": "4.0.6",
    "@sentry/rollup-plugin": "11.8.0",
    "@sentry/vite-plugin": "11.8.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@alchemy.run/axiom": "2.0.0-beta.84",
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@sentry/cloudflare": "11.8.0",
    "@sentry/react": "11.8.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "alchemy": "2.0.0-beta.84",
    "better-auth": "1.8.0-beta.3",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.6",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6",
    "rolldown": "1.2.15"
  }
}
